Window.SetBackgroundTopColor(0.031, 0.039, 0.047);
Window.SetBackgroundBottomColor(0.031, 0.039, 0.047);
logo_image = Image.Text("N E X U S", 0.957, 0.659, 0.145, 1, "DejaVu Sans 38");
logo = Sprite(logo_image);
logo.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
dot_image = Image.Text("•", 0.957, 0.659, 0.145, 1, "DejaVu Sans 24");
dot = Sprite(dot_image);
dot.SetY(Window.GetHeight() / 2 + 65);
global.phase = 0;
fun refresh() {
  global.phase += 0.04;
  dot.SetX(Window.GetWidth() / 2 + Math.Sin(global.phase) * 36 - dot_image.GetWidth() / 2);
  logo.SetOpacity(0.85 + Math.Sin(global.phase) * 0.15);
}
Plymouth.SetRefreshFunction(refresh);
