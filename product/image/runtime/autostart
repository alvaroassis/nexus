mkdir -p "$HOME/.local/state/nexus"
exec >>"$HOME/.local/state/nexus/session.log" 2>&1
printf '\nNexus graphical session: %s\n' "$(date -Is)"
xsetroot -solid "#101b1a"
xset s off
xset -dpms
xset s noblank
python3 /opt/nexus/portal.py &
# Keep the keyboard reachable above Chromium's fullscreen window.
gsettings set org.onboard.window force-to-top true
gsettings set org.onboard.window docking-enabled false
gsettings set org.onboard.icon-palette in-use true
gsettings set org.gnome.desktop.interface toolkit-accessibility true
gsettings set org.onboard.auto-show enabled true
gsettings set org.onboard start-minimized true
onboard &
/opt/nexus/kiosk.sh &
