mkdir -p "$HOME/.local/state/nexus"
exec >>"$HOME/.local/state/nexus/session.log" 2>&1
printf '\nNexus graphical session: %s\n' "$(date -Is)"
xsetroot -solid "#080a0c"
xset s off
xset -dpms
xset s noblank
python3 /opt/nexus/pointer.py &
python3 /opt/nexus/portal.py &
# The Nexus web keyboard owns touch input and viewport resizing.
/opt/nexus/kiosk.sh &


